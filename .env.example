# Copy this file to .env and fill in your values
# NEVER commit the .env file

# =============================================================================
# BINANCE CREDENTIALS
# =============================================================================
# Two envs (testnet + mainnet) × two key types (HMAC for REST, Ed25519 for
# WS user data streams) = four slots per env. The grid runner picks the
# slot that matches the resolved environment; unset mode-specific vars
# fall back to the generic BINANCE_* vars at the bottom.
#
# Recommended: ONE set of keys per env, no sharing. Generate the Ed25519
# keypair with `python -m scripts.generate_ed25519_keypair`.

# --- Testnet (paper money) ---------------------------------------------------
# Create at https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_WS_API_KEY=
BINANCE_TESTNET_WS_PRIVATE_KEY_PATH=keys/ed25519_testnet_priv.pem

# --- Mainnet (REAL MONEY) ----------------------------------------------------
# Create at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: disable withdrawals, enable IP whitelist on the API key.
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
BINANCE_MAINNET_WS_API_KEY=
BINANCE_MAINNET_WS_PRIVATE_KEY_PATH=keys/ed25519_mainnet_priv.pem

# --- Generic fallback (TESTNET ONLY — never applied in mainnet mode) ---------
# Pre-Phase-10 configs only had these; kept for backward-compat. If you're
# only running testnet, filling these is enough.
#
# IMPORTANT: mainnet intentionally does NOT fall back to these vars. This
# stops a testnet-only .env from accidentally routing live orders through
# a stale key. For mainnet you MUST set BINANCE_MAINNET_* above.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WS_API_KEY=
BINANCE_WS_PRIVATE_KEY_PATH=

# =============================================================================
# RUNTIME ENV SWITCH (Phase 10)
# =============================================================================
# Overrides settings.yaml `exchange.use_testnet`. CLI `--env` beats this.
#   testnet  → paper trading (default)
#   mainnet  → REAL MONEY (also requires --live or BINANCE_LIVE=yes)
BINANCE_ENV=testnet

# The "I understand this is real money" gate. Set to yes to run mainnet
# without passing --live on the command line (useful for scheduled runs
# under systemd/cron). Leave empty on workstations.
BINANCE_LIVE=

# =============================================================================
# TELEGRAM ALERTS + REMOTE CONTROL (Phase 11A)
# =============================================================================
# Two-way Telegram integration: alerts on fills/halts/crashes, and inbound
# /status /halt /help commands from the operator's phone. Optional — leave
# blank to keep the bot trading with no Telegram code path executed.
#
# Setup (one-time, ~3 minutes):
#   1. Open @BotFather in Telegram, send /newbot, follow prompts. You get
#      a bot token like "123456789:ABCdef-ghIJkl_mnopQRstuVWxyZ".
#   2. Send any message TO your new bot from your own Telegram account.
#   3. Get your chat id by visiting:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      Look for "chat":{"id":<NUMBER>} — that's your chat id. (Group chat
#      ids are negative; personal chat ids are positive.)
#   4. Paste the token + chat id below, then set telegram.enabled: true
#      in config/settings.yaml.
#   5. Restart the bot — you should see [BOOT] arrive in Telegram within
#      a few seconds. Send /help to verify the listener works.
#
# Multiple chat ids (e.g. personal + a shared group): comma-separated, no
# spaces. Every alert fans out to every id; every id can send commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# =============================================================================
# SENTIMENT API KEYS (future phases)
# =============================================================================
# CRYPTOPANIC_API_KEY=
# NEWSAPI_KEY=
