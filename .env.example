# Copy this file to .env and fill in your values
# NEVER commit the .env file

# Binance API — create at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: disable withdrawals, enable IP whitelist
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Use testnet for paper trading first
BINANCE_TESTNET=true

# Sentiment API keys (Phase 3)
# CRYPTOPANIC_API_KEY=
# NEWSAPI_KEY=
